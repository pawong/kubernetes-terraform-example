{
    "swagger": "2.0",
    "info": {
        "description": "A simple Magic 8 Ball REST API.",
        "title": "Magic 8 Ball API",
        "contact": {},
        "version": "1.0"
    },
    "host": "go.example.com",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Returns a simple hello message.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "General"
                ],
                "summary": "Root endpoint",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/8ball": {
            "get": {
                "description": "Returns a random Magic 8 Ball answer.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "8ball"
                ],
                "summary": "Get Magic 8 Ball answer",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Submit a question and receive a random Magic 8 Ball answer.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "8ball"
                ],
                "summary": "Ask the Magic 8 Ball",
                "parameters": [
                    {
                        "description": "Question",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.response"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.response"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns information about the running server.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "General"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/keepalive": {
            "get": {
                "description": "Simple endpoint used to verify the server is responding.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "General"
                ],
                "summary": "Keep alive",
                "responses": {
                    "200": {
                        "description": "I'm alive!",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.response": {
            "type": "object",
            "properties": {
                "answer": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                }
            }
        }
    }
