# Copy to secrets.auto.tfvars and fill in real values. Terraform loads *.auto.tfvars automatically.
#
#   % cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# secrets.auto.tfvars is untracked via the *.tfvars rule in .gitignore. Never commit it, and never
# rename it to something that rule does not match.
#
# Generate a value:
#
#   % LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
#
# Stick to A-Za-z0-9, since none of the connection strings here are URL-encoded.

postgresql_password = "CHANGE_ME"
mongodb_password    = "CHANGE_ME"

# Couchbase rejects anything shorter than 6 characters.
couchbase_password = "CHANGE_ME"
